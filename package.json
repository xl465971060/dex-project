  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
